{
  "name": "lata-velha-pos-tech-fiap-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Functions serverless de autenticacao por CPF e de autorizacao (Lata Velha - Pos Tech FIAP)",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:login && npm run build:authorizer",
    "build:login": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "build:authorizer": "esbuild src/authorizerHandler.ts --bundle --platform=node --target=node20 --outfile=dist/authorizer.js",
    "test": "jest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.637.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.4"
  }
}
